ameters":["也不是一个早睡的人，就出来透透气。"]},{"code":101,"indent":0,"parameters":["meng1",0,0,2]},{"code":401,"indent":0,"parameters":["【AMENG】"]},{"code":401,"indent":0,"parameters":["什么不好的预感？"]},{"code":101,"indent":0,"parameters":["jinmu1",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["明天大概率会出现棘手的情况，我们还是小心应"]},{"code":401,"indent":0,"parameters":["付。"]},{"code":101,"indent":0,"parameters":["meng1",0,0,2]},{"code":401,"indent":0,"parameters":["【AMENG】"]},{"code":401,"indent":0,"parameters":["真的吗？"]},{"code":101,"indent":0,"parameters":["meng1",0,0,2]},{"code":401,"indent":0,"parameters":["【AMENG】"]},{"code":401,"indent":0,"parameters":["我突然发现，这个地方能看到我们停在岸边的船"]},{"code":401,"indent":0,"parameters":["诶！"]},{"code":101,"indent":0,"parameters":["jinmu2",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["还真是，几乎就在正下方。"]},{"code":101,"indent":0,"parameters":["jinmu",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["先不说这些。蒙子，我们一起出来这么久了，你"]},{"code":401,"indent":0,"parameters":["觉得累吗？"]},{"code":101,"indent":0,"parameters":["meng7",0,0,2]},{"code":401,"indent":0,"parameters":["【AMENG】"]},{"code":401,"indent":0,"parameters":["有一点吧。"]},{"code":101,"indent":0,"parameters":["jinmu",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["我很累，就好像人生又重新开始了一次一样。"]},{"code":101,"indent":0,"parameters":["jinmu",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["人生好像总是要推翻一切，然后重新开始。"]},{"code":101,"indent":0,"parameters":["meng7",0,0,2]},{"code":401,"indent":0,"parameters":["【AMENG】"]},{"code":401,"indent":0,"parameters":["阿虎……"]},{"code":101,"indent":0,"parameters":["jinmu",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["我已经做出过很多选择了，你也是一样。"]},{"code":101,"indent":0,"parameters":["jinmu",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["就算这些选择产生了不好的后果，我们似乎也没"]},{"code":401,"indent":0,"parameters":["有倒退时间重新选择的能力。"]},{"code":101,"indent":0,"parameters":["meng7",0,0,2]},{"code":401,"indent":0,"parameters":["【AMENG】"]},{"code":401,"indent":0,"parameters":["是啊，有很多事情都变了，生活天翻地覆。"]},{"code":101,"indent":0,"parameters":["jinmu",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["我想我们的选择伤害了很多人。"]},{"code":101,"indent":0,"parameters":["meng7",0,0,2]},{"code":401,"indent":0,"parameters":["【AMENG】"]},{"code":401,"indent":0,"parameters":["嗯。"]},{"code":101,"indent":0,"parameters":["jinmu1",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["我们现在也正在接受选择带来的后果。"]},{"code":101,"indent":0,"parameters":["meng7",0,0,2]},{"code":401,"indent":0,"parameters":["【AMENG】"]},{"code":401,"indent":0,"parameters":["我习惯了，我活这么久几乎什么都经历过了。"]},{"code":101,"indent":0,"parameters":["jinmu1",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["人生就是由这样那样的选择拼凑而成的，我们自"]},{"code":401,"indent":0,"parameters":["己构建了我们的人生。"]},{"code":101,"indent":0,"parameters":["jinmu",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["但是现在我们都还在这里，说来可笑，我们确实"]},{"code":401,"indent":0,"parameters":["互不相欠了。"]},{"code":101,"indent":0,"parameters":["meng7",0,0,2]},{"code":401,"indent":0,"parameters":["【AMENG】"]},{"code":401,"indent":0,"parameters":["是啊，别人都叫我们跑跑兄弟了。"]},{"code":101,"indent":0,"parameters":["jinmu",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]},{"code":401,"indent":0,"parameters":["也许我们需要继续过自己的人生。我试过了，我"]},{"code":401,"indent":0,"parameters":["失败了，我很抱歉，我的一切都需要重新开始。"]},{"code":101,"indent":0,"parameters":["meng7",0,0,2]},{"code":401,"indent":0,"parameters":["【AMENG】"]},{"code":401,"indent":0,"parameters":["我也已经接受自己现在是小主播的事实了。"]},{"code":101,"indent":0,"parameters":["jinmu",0,0,2]},{"code":401,"indent":0,"parameters":["【JINMU】"]